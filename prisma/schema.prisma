generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (required by Auth.js adapter) ───────────────────────────

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String            @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Multi-Tenant Workspace ──────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  members         WorkspaceMember[]
  metaConnections MetaConnection[]
  flows           Flow[]
  leads           Lead[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ─── Meta Integration ────────────────────────────────────────────────────

model MetaConnection {
  id                String    @id @default(cuid())
  workspaceId       String
  igUserId          String
  igUsername         String
  pageId            String
  wabaId            String?
  phoneNumberId     String?
  accessToken       String    @db.Text
  accessTokenExpiry DateTime?
  webhookSubscribed Boolean   @default(false)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── Flow Builder ────────────────────────────────────────────────────────

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum TriggerType {
  COMMENT
  STORY_REPLY
  DM
  FOLLOW
  WA_MESSAGE
}

enum Channel {
  INSTAGRAM
  WHATSAPP
}

model Flow {
  id            String      @id @default(cuid())
  name          String
  description   String?
  workspaceId   String
  status        FlowStatus  @default(DRAFT)
  channel       Channel     @default(INSTAGRAM)
  triggerType   TriggerType
  triggerConfig Json?
  canvasData    Json        @default("{\"nodes\":[],\"edges\":[]}")
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions    FlowExecution[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Execution Tracking ──────────────────────────────────────────────────

enum ExecStatus {
  RUNNING
  COMPLETED
  FAILED
  WAITING
}

model FlowExecution {
  id          String     @id @default(cuid())
  flowId      String
  leadId      String?
  status      ExecStatus @default(RUNNING)
  currentNode String?
  context     Json?
  flow        Flow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  lead        Lead?      @relation(fields: [leadId], references: [id])
  startedAt   DateTime   @default(now())
  completedAt DateTime?
}

// ─── Leads & Messages ────────────────────────────────────────────────────

model Lead {
  id           String          @id @default(cuid())
  workspaceId  String
  igUserId     String?
  waId         String?
  igUsername   String?
  name         String?
  email        String?
  phone        String?
  tags         String[]        @default([])
  customFields Json?
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions   FlowExecution[]
  messages     Message[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([workspaceId, igUserId])
  @@unique([workspaceId, waId])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MsgType {
  TEXT
  IMAGE
  QUICK_REPLY
  TEMPLATE
  INTERACTIVE
}

model Message {
  id          String    @id @default(cuid())
  leadId      String
  direction   Direction
  content     String    @db.Text
  messageType MsgType   @default(TEXT)
  igMessageId String?   @unique
  waMessageId String?   @unique
  sentAt      DateTime  @default(now())
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}
